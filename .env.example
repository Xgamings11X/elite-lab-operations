# Vercel menyediakan VERCEL_PROJECT_PRODUCTION_URL.
# Opsional untuk domain khusus: APP_URL=https://portal.example.com
HOST=127.0.0.1
PORT=4173
# Isi koneksi PostgreSQL di Vercel Production untuk pendaftaran anggota.
# POSTGRES_URL juga dikenali jika disediakan oleh integrasi.
DATABASE_URL=
# Khusus Docker lokal, atur juga POSTGRES_PASSWORD.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# Opsional: kode pemulihan admin pertama, acak 32–100 karakter.
BOOTSTRAP_ADMIN_RECOVERY_CODE=
DEVICE_ID=ESP32-C3-LAB-01
DEVICE_TOKEN=
STORAGE_DIR=storage
TRUST_PROXY_HOPS=0

# Opsional: login privat pemilik untuk melihat data contoh.
OWNER_DEMO_USERNAME=
OWNER_DEMO_PASSWORD=
