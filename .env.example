# Vercel menyediakan VERCEL_PROJECT_PRODUCTION_URL.
# Opsional untuk domain khusus: APP_URL=https://portal.example.com
HOST=127.0.0.1
PORT=4173
# Tambahkan DATABASE_URL sendiri saat PostgreSQL sudah tersedia.
# Khusus Docker lokal, atur juga POSTGRES_PASSWORD.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Opsional: kode pemulihan admin pertama, acak 32–100 karakter.
BOOTSTRAP_ADMIN_RECOVERY_CODE=
DEVICE_ID=ESP32-C1-LAB-01
DEVICE_TOKEN=
STORAGE_DIR=storage
TRUST_PROXY_HOPS=0

# Opsional: login privat pemilik untuk melihat data contoh.
OWNER_DEMO_EMAIL=
OWNER_DEMO_PASSWORD=
